+  _UpdateVersion? _parseUpdateVersion(String raw) {
+    var value = raw.trim();
+    if (value.startsWith('v')) value = value.substring(1);
+
+    final match = RegExp(
+      r'^(\d+)\.(\d+)\.(\d+)(?:-pre\.?(\d+))?(?:\+(\d+))?$',
+      caseSensitive: false,
+    ).firstMatch(value);
+    if (match == null) return null;
+
+    return _UpdateVersion(
+      major: int.parse(match.group(1)!),
+      minor: int.parse(match.group(2)!),
+      patch: int.parse(match.group(3)!),
+      preReleaseNumber: match.group(4) == null
+          ? null
+          : int.parse(match.group(4)!),
+      buildNumber: match.group(5) == null
+          ? 0
+          : int.parse(match.group(5)!),
+    );
+  }
+
+  int _compareCore(_UpdateVersion a, _UpdateVersion b) {
+    final major = a.major.compareTo(b.major);
+    if (major != 0) return major;
+    final minor = a.minor.compareTo(b.minor);
+    if (minor != 0) return minor;
+    return a.patch.compareTo(b.patch);
+  }
+
+  int _compareUpdateVersions(_UpdateVersion a, _UpdateVersion b) {
+    final core = _compareCore(a, b);
+    if (core != 0) return core;
+
+    if (a.isPreRelease && b.isPreRelease) {
+      return a.preReleaseNumber!.compareTo(b.preReleaseNumber!);
+    }
+
+    if (a.isPreRelease && !b.isPreRelease) return -1;
+    if (!a.isPreRelease && b.isPreRelease) return 1;
+    return a.buildNumber.compareTo(b.buildNumber);
+  }
