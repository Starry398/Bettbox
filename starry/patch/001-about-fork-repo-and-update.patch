+  _UpdateVersion? _parseUpdateVersion(String raw) {
+    var value = raw.trim();
+    if (value.startsWith('v') || value.startsWith('V')) {
+      value = value.substring(1);
+    }
+    final match = RegExp(
+      r'^(\d+)\.(\d+)\.(\d+)(?:-(?:pre|beta|rc)\.?(\d*))?$',
+      caseSensitive: false,
+    ).firstMatch(value);
+    if (match == null) return null;
+    final pre = match.group(4);
+    return _UpdateVersion(
+      int.parse(match.group(1)!),
+      int.parse(match.group(2)!),
+      int.parse(match.group(3)!),
+      pre == null || pre.isEmpty ? null : int.parse(pre),
+    );
+  }
+
+  int _compareCore(_UpdateVersion a, _UpdateVersion b) {
+    final major = a.major.compareTo(b.major);
+    if (major != 0) return major;
+    final minor = a.minor.compareTo(b.minor);
+    if (minor != 0) return minor;
+    return a.patch.compareTo(b.patch);
+  }
+
+  int _compareUpdateVersion(_UpdateVersion a, _UpdateVersion b) {
+    final core = _compareCore(a, b);
+    if (core != 0) return core;
+    if (a.pre != null && b.pre != null) {
+      return a.pre!.compareTo(b.pre!);
+    }
+    if (a.pre != null) return -1;
+    if (b.pre != null) return 1;
+    return 0;
+  }
