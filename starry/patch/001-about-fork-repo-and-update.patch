 final utils = Utils();
+
+class _SemVer {
+  final int major;
+  final int minor;
+  final int patch;
+  final int? pre;
+  final int build;
+
+  const _SemVer(this.major, this.minor, this.patch, this.pre, this.build);
+
+  static _SemVer parse(String raw) {
+    var value = raw.trim();
+    if (value.startsWith('v') || value.startsWith('V')) {
+      value = value.substring(1);
+    }
+    var build = 0;
+    final buildIndex = value.indexOf('+');
+    if (buildIndex >= 0) {
+      build = int.tryParse(value.substring(buildIndex + 1)) ?? 0;
+      value = value.substring(0, buildIndex);
+    }
+    int? pre;
+    final preMatch = RegExp(
+      r'-(?:pre|beta|rc)\.?(\d*)$',
+      caseSensitive: false,
+    ).firstMatch(value);
+    if (preMatch != null) {
+      final digits = preMatch.group(1);
+      pre = digits == null || digits.isEmpty ? 0 : int.tryParse(digits) ?? 0;
+      value = value.substring(0, preMatch.start);
+    }
+    final parts = value.split('.');
+    int at(int index) =>
+        index < parts.length ? int.tryParse(parts[index].trim()) ?? 0 : 0;
+    return _SemVer(at(0), at(1), at(2), pre, build);
+  }
+}
